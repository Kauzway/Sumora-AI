# API Keys - Get your API key from NVIDIA NIM (https://build.nvidia.com/)
NVIDIA_API_KEY=your_nvidia_api_key_here

# NVIDIA NIM model ID. Default is meta/muse-glimmer-30b — a multimodal
# model with vision support, used for both slide-image transcription and
# text summary/chat. Browse live models at
# https://build.nvidia.com/explore/discover.
NVIDIA_MODEL=meta/muse-glimmer-30b

# Muse Glimmer reasoning budget, set via a "Reasoning strength:" line in the
# system prompt. One of: low / medium / high / xhigh. The model defaults to
# high, which spends tokens and wall-clock on chain of thought before the
# answer begins; these defaults keep it in budget against the per-call
# timeouts. Raise if answer quality matters more than latency.
REASONING_STRENGTH_TRANSCRIBE=low
REASONING_STRENGTH_SUMMARY=medium
REASONING_STRENGTH_CHAT=medium
REASONING_STRENGTH_OVERVIEW=low

# Flask configuration
FLASK_ENV=production
FLASK_DEBUG=0

# Rate limits for the NVIDIA NIM public tier: 40 RPM
RATE_LIMIT_RPM=40
RATE_LIMIT_RPD=10000
RATE_LIMIT_TPM=40000

# Google OAuth configuration
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here

# Application URL - Set this to your deployed URL in production
# For local development, this defaults to http://localhost:5002
APP_BASE_URL=https://your-app-url.run.app

# Production flag - set to "true" in production environments
PRODUCTION=true

# Secret key for session management - Use a strong random string
SECRET_KEY=your_secure_random_string_here 
